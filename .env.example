# --- YouTube ---
# The channel's UC... id. Resolve once from the @handle, e.g.:
#   curl "https://www.googleapis.com/youtube/v3/channels?part=id&forHandle=saintgeorgemelkite&key=YOUR_API_KEY"
YT_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# YouTube Data API v3 key (Google Cloud project -> enable YouTube Data API v3 -> API key)
YT_API_KEY=your-youtube-data-api-key

# --- Public URL ---
# The public HTTPS base URL that YouTube's hub can reach (e.g. your Cloudflare Tunnel hostname).
# No trailing slash. The webhook lives at <PUBLIC_BASE_URL>/youtube/webhook
PUBLIC_BASE_URL=https://your-tunnel-hostname.example.com
# Shared secret used to sign/verify WebSub notifications (any long random string)
WEBSUB_SECRET=change-me-to-a-long-random-string

# --- Facebook ---
# Numeric Page ID (Page -> About, or Graph API Explorer /me/accounts)
FB_PAGE_ID=1234567890
# Long-lived Page access token with pages_manage_posts + pages_read_engagement
FB_PAGE_TOKEN=your-long-lived-page-access-token
# Graph API version
FB_API_VERSION=v25.0

# --- Post content ---
# The Facebook post message. {title} = the live video's title, {description} =
# POST_DESCRIPTION below. Use \n for line breaks. Do NOT include the video URL
# here — it is attached automatically as a link-preview card.
POST_TEMPLATE={title}\n\n{description}
POST_DESCRIPTION=We're streaming live now.

# --- Runtime ---
# Where the SQLite dedupe db lives (mount this path as a volume for persistence)
DB_PATH=data/posted.sqlite3
# WebSub lease renewal interval in seconds (default ~4 days; hub lease is ~5-10 days)
RENEW_INTERVAL_SECONDS=345600
